use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use FindBin;
use lib "$FindBin::Bin/../lib";
use Pomodoro::Status;
use Pomodoro::Timer;

my $directory = tempdir(CLEANUP => 1);
my $publisher = Pomodoro::Status->new(directory => $directory);
my $reader = Pomodoro::Status->new(directory => $directory);
ok(!$reader->read->{running}, 'missing status is idle');
$publisher->acquire;
my $timer = Pomodoro::Timer->new;
$publisher->publish($timer);
my $state = $reader->read;
ok($state->{running}, 'recognizes live timer with held lock');
is($state->{text}, '25:00', 'publishes countdown');
is($state->{duration}, 1500, 'publishes full phase duration for charge meter');
is($state->{remaining}, 1500, 'publishes remaining seconds for charge meter');
$timer->tick(300);
$publisher->publish($timer);
is($reader->read->{remaining}, 1200, 'charge meter tracks elapsed time');
is($state->{pid}, $$, 'publishes process identity');
$timer->toggle_pause;
$publisher->publish($timer);
ok($reader->read->{paused}, 'publishes pause state');
my $duplicate = Pomodoro::Status->new(directory => $directory);
eval { $duplicate->acquire };
like($@, qr/already running/, 'rejects duplicate timers');
$publisher->clear;
ok(!$reader->read->{running}, 'cleanup clears status');
$duplicate->acquire;
$duplicate->publish($timer);
close delete $duplicate->{lock};
ok(!$reader->read->{running}, 'stale state without a held lock is idle');
done_testing;
