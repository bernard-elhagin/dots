use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Pomodoro::Timer;

my $timer = Pomodoro::Timer->new(work => 1, short => .1, long => .2, every => 2);
is($timer->remaining, 60, 'starts with a complete focus session');
$timer->tick(12.5);
is($timer->remaining, 47.5, 'tracks elapsed time precisely');
$timer->toggle_pause;
$timer->tick(30);
is($timer->remaining, 47.5, 'paused time does not count');
$timer->toggle_pause;
ok($timer->tick(100), 'expiration reports a transition');
is($timer->phase, 'short', 'first completed focus gives a short break');
is($timer->completed, 1, 'counts completed focus');
is($timer->remaining, 6, 'overrun does not consume the next break');
$timer->tick(6);
is($timer->phase, 'work', 'break leads back to focus');
$timer->tick(60);
is($timer->phase, 'long', 'second focus gives scheduled long break');
is($timer->remaining, 12, 'uses long break duration');
$timer->advance(0);
is($timer->phase, 'work', 'can skip a break');
$timer->advance(0);
is($timer->completed, 2, 'skipped focus is not counted');
is($timer->phase, 'short', 'skipped focus gives short break');
$timer->tick(2);
$timer->reset;
is($timer->remaining, 6, 'reset restores current duration');
done_testing;
